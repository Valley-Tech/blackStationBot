# ---- Meta / WhatsApp ---------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=
API_TOKEN=                      # token de usuario del sistema (solo si CRM_MODE=mirror o para descargar comprobantes)
BUSINESS_PHONE=                 # phone_number_id del número de La Estación
API_VERSION=v23.0
BASE_URL=https://graph.facebook.com
APP_SECRET=                     # para validar la firma del endpoint /flow
PORT=3000

# ---- Catálogo y Flows ----------------------------------------------------------
CATALOG_ID=                     # ID del catálogo en el Administrador de ventas de Meta
CATALOG_TEMPLATE=               # (opcional) plantilla con botón "Ver catálogo"
CATALOG_TEMPLATE_LANG=es_CO
CATALOG_TOKEN=                  # (opcional) token con catalog_management para scripts/actualizar-catalogo-meta.mjs
VARIANTES_META=true             # una tarjeta por grupo de variantes en los catálogos (false = cada variante por separado)
FLOW_ID_PEDIDO=
FLOW_ID_RESERVA=
FLOW_ID_ENCUESTA=
PRIVATE_KEY=                    # clave privada de los Flows (ver scripts/probar-clave.mjs)
PASSPHRASE=

# ---- Negocio -------------------------------------------------------------------
NOTIFY_NUMBERS=                 # números que reciben los avisos de pedido/reserva, separados por coma: 57300...,57311...
DOMICILIO_VALOR=3000            # valor del domicilio (0 si no se cobra)
HORA_APERTURA=16:00             # turno del chatbot (hora Colombia): 4:00 p. m.
HORA_CIERRE=00:00               # a 12:00 a. m. (puede pasar la medianoche). La bienvenida sale 1 vez por turno.
RECORDATORIO_PEDIDO_MIN=5       # v3.5: recordar el pedido sin terminar cada 5 min…
RECORDATORIO_PEDIDO_MAX=2       # …máximo 2 veces (0 = no recordar)
ADICIONAL_MINUTOS=60            # carrito dentro de 60 min tras llenar el Flow → se ofrece como ADICIONAL
