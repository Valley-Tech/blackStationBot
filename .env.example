# ---- Meta / WhatsApp ---------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=
API_TOKEN=                      # token de usuario del sistema (solo si CRM_MODE=mirror o para descargar comprobantes)
BUSINESS_PHONE=                 # phone_number_id del número de La Estación
API_VERSION=v23.0
BASE_URL=https://graph.facebook.com
APP_SECRET=                     # para validar la firma del endpoint /flow
PORT=3000

# ---- Catálogo y Flows ----------------------------------------------------------
CATALOG_ID=                     # ID del catálogo en el Administrador de ventas de Meta
CATALOG_TEMPLATE=               # (opcional) plantilla con botón "Ver catálogo"
CATALOG_TEMPLATE_LANG=es_CO
FLOW_ID_PEDIDO=
FLOW_ID_RESERVA=
FLOW_ID_ENCUESTA=
PRIVATE_KEY=                    # clave privada de los Flows (ver scripts/probar-clave.mjs)
PASSPHRASE=

# ---- Negocio -------------------------------------------------------------------
NOTIFY_NUMBERS=                 # números que reciben los avisos de pedido/reserva, separados por coma: 57300...,57311...
DOMICILIO_VALOR=3000            # valor del domicilio (0 si no se cobra)
HORA_APERTURA=12:00             # horario del chatbot para pedidos (hora Colombia)
HORA_CIERRE=23:00
CARTA_PARRILLA_URL=             # PDFs públicos (S3) que se envían al escribir "carta"
CARTA_PIZZERIA_URL=
CARTA_HELADERIA_URL=
IMAGEN_PEDIDO_URL=              # imagen del encabezado de la plantilla mensaje_nuevo_pedido
IMAGEN_RESERVA_URL=             # imagen del encabezado de la plantilla confirmacion_reserva
IMAGEN_EVENTO_URL=              # (opcional) imagen que se envía antes del Flow de reserva

# ---- Loggro POS (Pirpos) ---------------------------------------------------------
LOGGRO_API_KEY=
LOGGRO_TABLE_ID=                # mesa donde caen los pedidos de WhatsApp (p. ej. "Domicilios")
LOGGRO_LOCATION_STOCK=68f9ad7234a2d185b5e0bf68
LOGGRO_DOMICILIO_PRODUCT_ID=    # (opcional) producto "Domicilio" en Loggro

# ---- Pagos (Wompi) ---------------------------------------------------------------
URL_BASE_WOMPI=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=

# ---- Google Sheets (cuenta de servicio) -------------------------------------------
SPREADSHEETID_PEDIDO=
SPREADSHEETID_RESERVA=
SPREADSHEETID_SURVEY=
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=

# ---- AWS S3 (comprobantes de transferencia) ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ---- CRM ValleyTech ------------------------------------------------------------------
CRM_MODE=gateway                # gateway: el CRM entrega los mensajes en /crm/events
CRM_BASE_URL=https://crm-valleytech-production.up.railway.app
CRM_API_KEY=                    # API key del chatbot en el CRM
CRM_SIGNING_SECRET=             # secreto de firma del chatbot en el CRM
CRM_PHONE_NUMBER_ID=            # phone_number_id del número (igual a BUSINESS_PHONE)
